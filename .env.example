# STAGEKIT PRO Environment Variables
# Copy this to .env and fill in your API keys

# ═══════════════════════════════════════════════════════════
# MARBLE API (World Labs)
# Platform: https://platform.worldlabs.ai
# Docs: https://docs.worldlabs.ai
# ═══════════════════════════════════════════════════════════
VITE_MARBLE_API_KEY=your_marble_api_key_here
VITE_MARBLE_API_BASE=https://platform.worldlabs.ai

# ═══════════════════════════════════════════════════════════
# AKOOL API
# Docs: https://openapi.akool.com
# ═══════════════════════════════════════════════════════════
VITE_AKOOL_API_KEY=your_akool_api_key_here
VITE_AKOOL_API_BASE=https://openapi.akool.com/api/open/v3
